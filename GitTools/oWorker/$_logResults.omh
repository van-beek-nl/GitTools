If isclear(ivResult)
	Quit method
End If

If not(isclear(ivResult.log))
	For ivResult.log.$line from 1 to ivResult.log.$linecount step 1
		Do tvLogger.$log(ivResult.log.C1.level,ivResult.log.C1.message)
	End For
End If

If ivResult.ok=kTrue
	Quit method
End If

If isclear(ivResult.error)
	Do tvLogger.$error("An unknown worker error occurred")
	Quit method
End If

Do tvLogger.$error(ivResult.error.code," - ",ivResult.error.message)