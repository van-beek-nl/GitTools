Calculate ivResult as #NULL

If $cinst.$state<>kWorkerStateRunning
	If not($cinst.$init())
		Do $cinst.$_fail(-1,"Unable to initialize worker")
	End If
	
	If not($cinst.$start())
		Do $cinst.$_fail(-1,"Unable to start worker")
	End If
	
	If isclear(ivResult)
		Calculate lvCT as #CT
		While $cinst.$state<>kWorkerStateRunning&#CT-lvCT<cvWorkerStartTimeout
			# Wait for worker to start, this can take a brief moment
		End While
	End If
End If

If $cinst.$state=kWorkerStateRunning
	Do $inherited.$callmethod("gittools_worker",pMethod,pParameters,kTrue,lvErrorText) Returns lvIsOk
	If not(lvIsOk)&isclear(ivResult)
		Do $cinst.$_fail(-1,lvErrorText)
	End If
Else If isclear(ivResult)
	Do $cinst.$_fail(-1,"Unknown worker error")
End If

Do $cinst.$_logResults(ivResult)
Quit method ivResult