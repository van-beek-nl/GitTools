If isclear(cvWorkingMessage)
	Quit method kFalse
End If

If not(cvWorkingMessage.$secondary.$cando())
	Do $cinst.$closeWorkingMessage()
	Quit method $cinst.$showWorkingMessage(pTitle,pBody)
End If

If not(isclear(pTitle))
	Calculate cvWorkingMessage.$primary as con('GitTools - ',pTitle)
End If

If not(isclear(pBody))
	Calculate cvWorkingMessage.$secondary as pBody
End If

Quit method kTrue