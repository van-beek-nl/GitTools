If not($cinst.$gitAvailable)
	Do tvLogger.$error("Git is not available. Refusing to register libraries at this time.")
	Quit method kFalse
End If

Do tvFileUtilities.$normalizePath(pConfigFilePath) Returns pConfigFilePath
Calculate lvRegistration.id as tvFileUtilities.$configPathToLibraryID(pConfigFilePath)
Calculate lvRegistration.basePath as FileOps.$parentdir(pConfigFilePath)
Calculate lvRegistration.libraryPath as tvFileUtilities.$configPathToLibraryPath(pConfigFilePath)
Calculate lvRegistration.configPath as pConfigFilePath

If ivRegisteredLibraries.$search($ref.libraryPath=lvRegistration.libraryPath,kTrue,kFalse,kFalse,kFalse)
	Do tvLogger.$debug("Skipping registration of ",lvRegistration.id," as it is already registered")
	Quit method kTrue
End If

# Read config file
If not(FileOps.$doesfileexist(pConfigFilePath))
	Do tvLogger.$debug("Skipping registration of ",lvRegistration.id," as it does not have a config file")
	Quit method kFalse
End If

If not(lvFile.$openfile(pConfigFilePath,kTrue))
	Do tvLogger.$error("Could not open config file for ",lvRegistration.id)
	Quit method kFalse
End If
Do lvFile.$readcharacter(kUniTypeUTF8,lvConfigText)
Do lvFile.$closefile()

# Parse config file
Do OJSON.$jsontolistorrow(lvConfigText,lvError,kTrue) Returns lvParsedConfig
If isnull(lvParsedConfig)
	Do tvLogger.$error("Could not parse config file for ",lvRegistration.id,": ",lvError)
	Quit method kFalse
End If

# Sanitize config
Do lvConfiguration.$assignrow(lvParsedConfig,kTrue)
If isclear(lvConfiguration.jsonPath)
	Calculate lvConfiguration.jsonPath as "./src"
End If

Calculate lvRegistration.jsonPath as tvFileUtilities.$normalizePath(tvFileUtilities.$join(FileOps.$parentdir(lvRegistration.libraryPath),lvConfiguration.jsonPath))
Calculate lvRegistration.releasePath as tvFileUtilities.$getAbsolutePath(lvConfiguration.releasePath,FileOps.$parentdir(pConfigFilePath))
Calculate lvRegistration.preImportScript as lvConfiguration.preImportScript
Calculate lvRegistration.postImportScript as lvConfiguration.postImportScript
Calculate lvRegistration.preExportScript as lvConfiguration.preExportScript
Calculate lvRegistration.postExportScript as lvConfiguration.postExportScript

Do ivWorker.$bootstrapRepository(lvRegistration,tvSettings.$autoUpdateRepositoryConfig) Returns lvResult
If lvResult.ok<>kTrue
	Do tvLogger.$error("Bootstrapping failed for ",lvRegistration.id)
	Quit method kFalse
End If

Do ivRegisteredLibraries.$add().$assignrow(lvRegistration,kTrue)
Do tvLogger.$info("Registered library ",lvRegistration.id)
Do tvMenu.$buildMenu()

Quit method kTrue