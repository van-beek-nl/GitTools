Do ivRegisteredLibraries.$search($ref.id=pLibraryID,kTrue,kFalse,kFalse,kFalse)
Calculate lvRegistration as ivRegisteredLibraries

If isclear(lvRegistration)
	Do tvLogger.$error("Unable to clear export cache for library ",pLibraryID,": library registration not found")
	Quit method kFalse
End If

Do tvLogger.$info("Clearing export cache for ",pLibraryID)

Do ivWorker.$clearExportCache(lvRegistration) Returns lvWorkerResult
If not(lvWorkerResult.ok)
	If not(isclear(lvWorkerResult.error.message))
		OK message GitTools - [lvWorkerResult.error.code] {[lvWorkerResult.error.message]}
	End If
	
	Do tvLogger.$error("Worker clearExportCache reported error - Aborting")
	Quit method kFalse
End If

Do $cinst.$$showToast(con(pLibraryID," export cache"),"Export cache cleared successfully.",kToastSuccess)

Quit method kTrue