If isclear(pLibrary.$pathname())
	Do tvLogger.$error("Unable to obtain pathname from library reference. Are you sure you passed a valid library reference?")
	Quit method kFalse
End If

Quit method $cinst.$deregisterLibrary(tvFileUtilities.$configPathToLibraryID(tvFileUtilities.$libraryPathToConfigPath(pLibrary.$pathname())),pWaitForClose)