Do tvLogger.$showWorkingMessage("Registering libraries") Returns lvShowingWorkingMessage

Do $libs.$makelist($ref) Returns lvOpenLibraries

If pForce
	Do tvLogger.$debug("Force-updating the library register")
	Do ivRegisteredLibraries.$clear()
Else If pPruneStaleEntries
	Do tvLogger.$debug("Cleaning up stale library registrations")
	For ivRegisteredLibraries.$line from ivRegisteredLibraries.$linecount to 1 step -1
		If not(ivRegisteredLibraries.autoPrune)
			Jump to start of loop
		End If
		
		If not(lvOpenLibraries.$search($ref.C1().$pathname=ivRegisteredLibraries.libraryPath,kTrue,kFalse,kFalse,kFalse))
			Do $cinst.$deregisterLibrary(ivRegisteredLibraries.id)
		End If
	End For
End If

Do tvLogger.$debug("Attempting to register all currently open libraries")
For lvOpenLibraries.$line from 1 to lvOpenLibraries.$linecount step 1
	If lvShowingWorkingMessage
		Do tvLogger.$updateWorkingMessage(#NULL,con(lvOpenLibraries.C1().$name," (",lvOpenLibraries.$line,"/",lvOpenLibraries.$linecount,")"))
	End If
	
	Do $cinst.$registerLibraryByReference(lvOpenLibraries.C1)
End For

If lvShowingWorkingMessage
	Do tvLogger.$closeWorkingMessage()
End If